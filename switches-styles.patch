@@ -0,0 +1,100 @@
+:host {
+    display: block;
+    color-scheme: light;
+    color: #334155;
+    background: transparent;
+}
+
+.reactive-container {
+    max-width: 950px;
+    margin: 35px auto;
+    padding: 0 20px;
+
+    --surface: #ffffff;
+    --surface-soft: #f8fafc;
+    --border: #e2e8f0;
+    --text: #334155;
+    --text-muted: #64748b;
+    --accent: #6366f1;
+}
+
+/* HEADER */
+
+.page-header {
+    margin-bottom: 28px;
+}
+
+.page-header h2 {
+    font-size: 1.85rem;
+    font-weight: 750;
+    letter-spacing: -0.7px;
+    color: #1e293b;
+    margin-bottom: 7px;
+}
+
+.page-header h2 small {
+    color: var(--accent);
+    font-size: 1rem;
+    font-weight: 600;
+    margin-left: 5px;
+}
+
+.page-header p {
+    color: var(--text-muted);
+    font-size: 0.92rem;
+    margin: 0;
+}
+
+/* FORM CARD */
+
+.form-card {
+    background: var(--surface);
+    color: var(--text);
+    border: 1px solid var(--border);
+    border-radius: 18px;
+    padding: 32px;
+    box-shadow: 0 4px 6px rgba(15, 23, 42, 0.02), 0 12px 30px rgba(15, 23, 42, 0.045);
+}
+
+/* LABELS */
+
+.form-card .col-form-label {
+    font-weight: 650;
+    font-size: 0.9rem;
+    color: #334155;
+}
+
+/* FOOTER */
+
+.form-footer {
+    display: flow-root;
+    padding-top: 22px;
+    margin-top: 28px;
+    border-top: 1px solid var(--border);
+}
+
+/* RESPONSIVE */
+
+@media (max-width: 768px) {
+    .form-card { padding: 24px; }
+}
+
+@media (max-width: 576px) {
+    .reactive-container {
+        padding: 0 12px;
+        margin: 22px auto;
+    }
+
+    .page-header h2 {
+        font-size: 1.55rem;
+    }
+
+    .form-card {
+        padding: 20px 15px;
+        border-radius: 14px;
+    }
+
+    .form-card .col-form-label {
+        padding-bottom: 6px;
+    }
+}
